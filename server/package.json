{
  "name": "transit-tracker-server",
  "version": "1.0.0",
  "description": "Collects live New York transit feeds and serves vehicle positions",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
