# Copy this file to .env and fill in your own values. Never commit .env.
# Free key from https://register.developer.obanyc.com/ (enables MTA bus positions)
MTA_BUSTIME_KEY=
PORT=3000
# Optional: an Apple Push Notifications key, so the iPhone app's Live Activities update while it is closed.
# APNS_KEY is the whole .p8 file (on one line, \n can stand for each line break).
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
