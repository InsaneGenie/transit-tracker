{
  "expo": {
    "name": "NY Transit Live",
    "slug": "ny-transit-live",
    "version": "1.0.36",
    "orientation": "portrait",
    "scheme": "nytransitlive",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "bundleIdentifier": "com.insanegenie.nytransitlive",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.insanegenie.nytransitlive",
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show where you are on the map, so you can see the buses and trains near you. It stays on your phone."
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "NextArrivals",
              "displayName": "Next trains and buses",
              "description": "The next arrivals at a station you saved in the app.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "initialLayout": "./src/widgets/ArrivalsWidget.tsx",
                "configuration": {
                  "title": "Station",
                  "description": "Pick which saved station this widget shows.",
                  "parameters": {
                    "station": {
                      "title": "Station",
                      "type": "enum",
                      "dynamic": true,
                      "default": "first",
                      "values": [
                        {
                          "name": "First saved station",
                          "value": "first"
                        }
                      ]
                    }
                  }
                }
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "189e500f-c9b9-454c-9455-1aedcc4addf4"
      }
    },
    "owner": "crazygenie"
  }
}
